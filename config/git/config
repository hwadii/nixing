[core]
  editor = $EDITOR
  excludesfile = ~/.config/git/ignore
  attributesFile = ~/.config/git/attributes
[user]
  name = Wadii Hajji
  email = wadii.hajji@proton.me
  signingkey = 01A2E2A2A8EE8448
[fetch]
  prune = true
  pruneTags = true
  all = true
[pull]
  rebase = false
[push]
  autoSetupRemote = true
[rebase]
  autoSquash = true
  autoStash = true
  updateRefs = true
[pager]
  branch = false
[showbranch]
  default = --topo-order
[branch]
  sort = -committerdate
[absorb]
  maxStack = 20
[merge]
  tool = diffview
  conflictstyle = zdiff3
[mergetool]
  prompt = false
  keepBackup = false
[init]
  defaultBranch = main
[safe]
  directory = *
[github]
  user = hwadii
[commit]
  gpgsign = true
  verbose = true
[diff]
  colorMoved = plain
  algorithm = histogram
  mnemonicPrefix = true
  renames = true
[rerere]
  enabled = true
  autoupdate = true
[column]
  ui = auto
[tag]
  sort = version:refname
[includeIf "gitdir:~/code/cardiologs/"]
  path = ~/.config/git/philips
[includeIf "gitdir:~/dev/tenderbolt/"]
  path = ~/.config/git/tenderbolt
